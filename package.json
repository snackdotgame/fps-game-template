{
  "name": "fps-game-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev:client dev:server --parallel",
    "dev:client": "vite",
    "dev:server": "snack dev",
    "tc": "tsgo --project tsconfig.client.json --noEmit && tsgo --project tsconfig.server.json --noEmit",
    "typecheck": "tsgo --project tsconfig.client.json --noEmit && tsgo --project tsconfig.server.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "check": "oxfmt --check . && tsgo --project tsconfig.client.json --noEmit && tsgo --project tsconfig.server.json --noEmit && oxlint .",
    "build:client": "vite build",
    "build:server": "snack build",
    "test:char-sync": "esbuild scripts/char-controller-sync-test.ts --bundle --format=esm --platform=node --external:jolt-ts --external:module --outfile=node_modules/.cache/cc-sync-test.mjs && node node_modules/.cache/cc-sync-test.mjs",
    "test:reconcile": "esbuild scripts/movement-reconcile-test.ts --bundle --format=esm --platform=node --external:jolt-ts --external:jolt-ts/* --external:module --outfile=node_modules/.cache/reconcile-test.mjs && node node_modules/.cache/reconcile-test.mjs",
    "test:controller": "esbuild scripts/controller-feel-test.ts --bundle --format=esm --platform=node --external:jolt-ts --external:jolt-ts/* --external:module --outfile=node_modules/.cache/controller-feel-test.mjs && node node_modules/.cache/controller-feel-test.mjs",
    "build": "vite build && snack build",
    "deploy": "vite build && snack deploy",
    "publish": "vite build && snack publish"
  },
  "dependencies": {
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "jolt-ts": "^0.1.0",
    "jolt-ts-character-controller": "^0.1.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@snack-game/cli": "^0.1.16",
    "@types/three": "^0.184.1",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "esbuild": "0.27.3",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "turbo": "2.7.2",
    "vite": "7.3.0"
  },
  "packageManager": "npm@11.12.1"
}
