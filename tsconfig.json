{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["vite/client", "./.snack/types/client", "./.snack/types/server"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", ".snack/types/**/*.d.ts"]
}
