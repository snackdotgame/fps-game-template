{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["./.snack/types/server"],
    "lib": ["ES2022", "ESNext.Disposable"]
  },
  "include": [
    "src/server.ts",
    "src/server/**/*.d.ts",
    "src/shared/**/*.ts",
    ".snack/types/**/*.d.ts"
  ]
}
